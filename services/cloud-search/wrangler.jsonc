{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "campusos-preview-cloud-search",
  "main": "worker.mjs",
  "account_id": "5328fbf5ef7ef40f7743723c2c192499",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "services": [
    { "binding": "REDBOOK_SEARCH", "service": "campusos-xhs-redbook-eval" },
  ],
  "browser": { "binding": "BROWSER" },
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "SearchContainer",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 1,
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SEARCH_CONTAINER", "class_name": "SearchContainer" },
      { "name": "MANAGED_XHS", "class_name": "ManagedXhs" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SearchContainer"] },
    { "tag": "v2", "new_sqlite_classes": ["ManagedXhs"] },
  ],
  "r2_buckets": [
    {
      "binding": "SESSIONS",
      "bucket_name": "campusos-preview-search-sessions",
    },
  ],
}
