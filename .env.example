# Public origin is a project-owned domain. DNS/deployment is not yet connected.
NEXT_PUBLIC_APP_URL=https://gdufs.ccwu.cc
APP_ENV=local

# Server secrets only. Never use a NEXT_PUBLIC_ prefix for secrets.
# The published JS API key will later be returned through a controlled config API.
AMAP_WEB_KEY=
AMAP_SECURITY_JS_CODE=
AMAP_WEBSERVICE_KEY=
MODEL_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=
# Dify Chatflow app API key; server-side only. Keep empty until the flow is published.
DIFY_APP_API_KEY=
DIFY_CHAT_ENABLED=false
# Server-owned capability receipt written only after model:verify succeeds (expires after 24h).
MODEL_CAPABILITIES_JSON=
AGENT_SIGNING_SECRET=
EMBEDDING_MODEL=
SMS_PROVIDER=
SMS_API_KEY=
SMS_TEMPLATE_ID=

# S3-A Console server settings. Empty means closed. No NEXT_PUBLIC_ credentials.
CONSOLE_AUTH_MODE=
CONSOLE_ADMIN_EMAILS=
CONSOLE_SESSION_SECRET=
CONSOLE_ACCESS_TEAM_DOMAIN=
CONSOLE_ACCESS_AUD=
CONSOLE_LOCAL_ACCESS_KEY=
CONSOLE_ADMIN_ACCESS_KEY=
# admin_password: store SHA256(PBKDF2-derived key) above; public random salt below.
CONSOLE_CREDENTIAL_SALT=
CONSOLE_ORIGIN=
# Optional exact HTTPS origins accepted by the same shared Preview Worker.
CONSOLE_ALLOWED_ORIGINS=

# Campus gateway (modelsq.gdufs.edu.cn). Only reachable from the campus
# network, so it is opt-in: set MODEL_PRIORITY=gdufs to make it the primary
# tier. The receipt must be produced by the same real verification as MODEL_*.
GDUFS_MODEL_NAME=
GDUFS_MODEL_BASE_URL=
GDUFS_MODEL_API_KEY=
GDUFS_MODEL_CAPABILITIES_JSON=
