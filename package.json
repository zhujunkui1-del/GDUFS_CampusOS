{
  "name": "campusos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/prepare-map-runtime.mjs",
    "prebuild": "node scripts/prepare-map-runtime.mjs",
    "prebuild:worker": "node scripts/prepare-map-runtime.mjs",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:worker": "opennextjs-cloudflare build",
    "preview:worker": "opennextjs-cloudflare preview",
    "db:migrate:local": "wrangler d1 migrations apply campusos-local --local",
    "db:verify": "node scripts/verify-database.mjs",
    "model:verify": "node scripts/verify-model.mjs",
    "skills:verify:live": "node scripts/verify-map-skills.mjs",
    "deploy:preview": "node scripts/deploy.mjs preview",
    "deploy:production": "node scripts/deploy.mjs production"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "gcoord": "1.0.7",
    "lucide-react": "1.55.0",
    "maplibre-gl": "6.14.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@amap/amap-jsapi-types": "0.0.15",
    "@opennextjs/cloudflare": "1.20.10",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "0.186.0",
    "comment-json": "4.5.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "wrangler": "4.149.0"
  },
  "allowScripts": {
    "rclone.js@0.6.6": false,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261006.1": true,
    "esbuild@0.25.4": true
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    },
    "rclone.js": {
      "adm-zip": "0.6.1"
    }
  }
}
